{
  "name": "better-buddy-share-backend",
  "private": "true",
  "scripts": {
    "typecheck": "bunx --bun tsc -p tsconfig.json --noEmit",
    "dev": "bun --hot src/index.ts",
    "db": "bunx --bun prisma migrate deploy",
    "minify": "bun run typecheck && bun build src/index.ts --target bun --outdir .dist --minify --sourcemap",
    "prod": "bun run db && bun run --bun .dist/index.js",
    "docs": "typedoc && bun run scripts/fix-wiki-links.js",
    "docs:wiki": "typedoc --options typedoc.json --out docs/wiki --plugin typedoc-plugin-markdown && bun run scripts/fix-wiki-links.js",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.ts": "prettier --write",
    "*.tsx": "prettier --write",
    "*.js": "prettier --write",
    "*.jsx": "prettier --write"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@prisma/client": "^7.9.1",
    "hono": "^4.13.2",
    "lodash": "^4.18.1",
    "rabbitmq-client": "^5.0.8"
  },
  "devDependencies": {
    "@0xts/gitleaks-cli": "^0.1.3",
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@types/bun": "^1.3.14",
    "@types/lodash": "^4.17.25",
    "@types/swagger-ui-dist": "^3.30.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "mermaid": "^11.16.1",
    "prettier": "^3.9.6",
    "prettier-plugin-embed": "^0.5.1",
    "prettier-plugin-nginx": "^1.0.3",
    "prettier-plugin-prisma": "^5.0.0",
    "prettier-plugin-sql": "^0.20.0",
    "prisma": "^7.9.1",
    "tsconfig-paths": "^4.2.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-dt-links": "^2.0.67",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-plugin-mermaid": "^1.12.0",
    "typescript": "^7.0.2"
  }
}
